<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <AssemblyName>CasterDesk.Engine</AssemblyName>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../source-core/CasterDesk.Core.csproj" />
    <Compile Include="../source/MatchInterchangeTests.cs;../source/BackupTests.cs;../source/ImageOptimizationTests.cs" Link="Checks/%(Filename)%(Extension)" />
    <Compile Include="../source-wpf/StabilityChecks.cs;../source-wpf/Configuration.cs" Link="Checks/%(Filename)%(Extension)" />
    <Content Include="../tests/Fixtures/Ocr/*.json" Link="test-fixtures/ocr/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
